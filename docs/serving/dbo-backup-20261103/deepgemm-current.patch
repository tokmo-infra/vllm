-            case MmaKind::MXF4:
-            case MmaKind::NVFP4:
-                return {align(block_m, num_utccp_aligned_elems), align(block_n, num_utccp_aligned_elems)};
-            default: DG_HOST_UNREACHABLE("Unknown dtype");
-        }
-    }
