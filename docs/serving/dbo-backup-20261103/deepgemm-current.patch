-
-        // This line has an implicit FP32-to-BF16 casting
-        torch_compat::copy_(d, workspace);
-        return;
-    }
-
-    DG_HOST_ASSERT(a.is_contiguous());
-    DG_HOST_ASSERT(b.is_contiguous());
-    DG_HOST_ASSERT(d.is_contiguous());
-
-    const auto [s , m, k ] = get_shape<3>(a);
