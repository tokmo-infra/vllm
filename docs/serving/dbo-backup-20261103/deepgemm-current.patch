-def quantize(x, mode, scale=1.0):
-    if mode == 'nvfp4':
-        return per_token_cast_to_nvfp4(x, scale)
-    if mode == 'fp4':
-        return per_token_cast_to_fp4(x, True, 32, True)
-    return per_token_cast_to_fp8(x, True, 32, True)
