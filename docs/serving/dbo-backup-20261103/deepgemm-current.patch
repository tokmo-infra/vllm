-    const std::optional<torch::stable::Tensor>& shared_l2_weights_opt,
-    const std::optional<torch::stable::Tensor>& x_bf16_opt,
-    const std::optional<torch::stable::Tensor>& cumulative_local_expert_recv_stats,
