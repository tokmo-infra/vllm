-            num_pool_blocks, num_sms, hidden, intermediate_hidden);
-        num_ring_tokens = std::max(num_ring_tokens, num_live_pool_blocks * block_m);
-    }
-    num_ring_tokens = math::align(num_ring_tokens, layout::kLCMCandidateBlockM);
