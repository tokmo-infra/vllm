-                                                             const std::optional<float>& alpha = std::nullopt,
-                                                             const std::optional<torch::stable::Tensor>& sfd = std::nullopt) {
-    DG_HOST_ASSERT((epilogue_class != nullptr) + alpha.has_value() + sfd.has_value() <= 1 and
