-static void fp4_fp4_mega_moe(
-    const torch::stable::Tensor& y,
-    const std::tuple<torch::stable::Tensor, torch::stable::Tensor>& l1_weights_tuple,
-    const std::tuple<torch::stable::Tensor, torch::stable::Tensor>& l2_weights_tuple,
