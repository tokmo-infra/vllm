-    # L2 GEMM -> BF16 partial (fc2 * l2_alpha), THEN apply the top-k weight post-L2 in FP32
-    # -> BF16 (mirrors the kernel's combine-write scaling); the combine sums in FP32.
-    partial = ((act_dq @ w2_dq.t()) * l2_alpha).bfloat16()
