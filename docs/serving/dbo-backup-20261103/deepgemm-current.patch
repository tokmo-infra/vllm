-            } else {
-                // NOTES: smaller block M can avoid TMA L2 OOB bound
-                // TODO: consider block M = 256
-                if (desc.m <= 32) block_m_candidates = {32};
-                else if (desc.m <= 64) block_m_candidates = {64};
-                else block_m_candidates = {128};
