diff --git a/vllm/v1/ttft_flight.py b/vllm/v1/ttft_flight.py
new file mode 100644
index 0000000000000000000000000000000000000000..5a3056f94d77627352d002753607c1621e0540bc
--- /dev/null
+++ b/vllm/v1/ttft_flight.py
@@ -0,0 +1,63 @@
+"""Task-local P flight recorder; never waits on the CUDA stream."""
+import collections
+import contextlib
+import functools
+import json
+import logging
+import os
+import threading
+import time
+
+_ring = collections.deque(maxlen=160)
+_active = {}
+_start_lock = threading.Lock()
+_started = False
+_log = logging.getLogger(__name__)
+
+
+def mark(label, *args):
+    _ring.append((round(time.monotonic(), 6), threading.get_ident(), label, args))
+
+
+def _watch():
+    reported = set()
+    while True:
+        time.sleep(1)
+        now = time.monotonic()
+        snapshot = _active.copy()
+        slow = {token for token, rec in snapshot.items() if now - rec[-1] >= 5}
+        if slow - reported:
+            _log.warning("TTFT_FLIGHT %s", json.dumps({
+                'pid': os.getpid(), 'mono_s': now,
+                'active': list(snapshot.values()), 'tail': list(_ring.copy()),
+            }))
+        reported = slow
+
+
+@contextlib.contextmanager
+def span(label, details=None):
+    global _started
+    if not _started:
+        with _start_lock:
+            if not _started:
+                threading.Thread(target=_watch, name="ttft-flight", daemon=True).start()
+                _started = True
+    args = () if details is None else details()
+    key = object()
+    start = time.monotonic()
+    _active[key] = (threading.get_ident(), label, args, start)
+    try:
+        yield
+    finally:
+        _active.pop(key, None)
+        mark(label + ".done", round(time.monotonic()-start, 6), *args)
+
+
+def record(label, details=None):
+    def decorate(fn):
+        @functools.wraps(fn)
+        def call(*args, **kw):
+            with span(label, details):
+                return fn(*args, **kw)
+        return call
+    return decorate
