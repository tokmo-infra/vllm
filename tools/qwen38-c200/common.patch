@@ -0,0 +1,190 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Bounds for the experimental local QSA main KV format."""
+
+import math
+import struct
+from dataclasses import dataclass
+
+import torch
+
+from vllm.v1.attention.ops.nvfp4_kv import nvfp4_kv_views
+from vllm.v1.kv_cache_interface import AttentionSpec
+
+QSA_NVFP4_FLASHINFER_SHA = "1658f0bf02b65fe9a71862286f6da546d0fce890"
+
+
+@dataclass(frozen=True)
+class QsaNvfp4PageRegion:
+    base: int
+    stride: int
+    size: int
+    abi: str
+
+
+def qsa_nvfp4_token_segments(
+    cache: torch.Tensor,
+    spec: AttentionSpec,
+    block_id: int,
+    start: int,
+    stop: int,
+) -> tuple[tuple[int, int], ...]:
+    """Exact data/scale spans of the selected token interval, in wire order."""
+    validate_qsa_nvfp4_binding(cache, spec.num_kv_heads, spec.block_size)
+    if not 0 <= block_id < cache.shape[0] or not 0 <= start < stop <= spec.block_size:
+        raise ValueError("QSA NVFP4 block or token slice is out of bounds")
+    data, scales, order = nvfp4_kv_views(cache, spec.num_kv_heads)
+    regions = []
+    for tensor in (data[0], scales[0], data[1], scales[1]):
+        page = tensor[block_id]
+        if order == "NHD":
+            rows = (page[start:stop],)
+        else:
+            rows = (head[start:stop] for head in page.unbind(0))
+        regions.extend((row.data_ptr(), row.nbytes) for row in rows)
+    return tuple(regions)
+
+
+def qsa_nvfp4_page_region(
+    cache: torch.Tensor,
+    spec: AttentionSpec,
+    scales: tuple[float, float],
+) -> QsaNvfp4PageRegion:
+    """Describe transferable bytes without including inter-layer padding."""
+    if not spec.kv_quant_mode.is_nvfp4 or spec.head_size != 256:
+        raise ValueError("Expected a packed D=256 QSA NVFP4 spec")
+    validate_qsa_nvfp4_binding(cache, spec.num_kv_heads, spec.block_size)
+    _, _, order = nvfp4_kv_views(cache, spec.num_kv_heads)
+    size = cache[0].nbytes
+    if size != spec.real_page_size_bytes:
+        raise ValueError("QSA NVFP4 tensor payload does not match its cache spec")
+    if not all(math.isfinite(scale) and scale > 0 for scale in scales):
+        raise ValueError("QSA NVFP4 global scales must be finite and positive")
+    scale_id = struct.pack("!ff", *scales).hex()
+    abi = f"qsa-nvfp4-v1:{order}:{spec.num_kv_heads}:{spec.block_size}:{scale_id}"
+    return QsaNvfp4PageRegion(cache.data_ptr(), cache.stride(0), size, abi)
+
+
+class QsaNvfp4:
+    """Paired slot writer and gated QSA reader; both consume the same page ABI."""
+
+    def __init__(self, num_kv_heads: int):
+        import flashinfer
+
+        if getattr(flashinfer, "__git_commit__", None) != QSA_NVFP4_FLASHINFER_SHA:
+            raise RuntimeError(
+                f"QSA NVFP4 requires FlashInfer {QSA_NVFP4_FLASHINFER_SHA} "
+                "built with the SM120 Cake sources"
+            )
+        from flashinfer import nvfp4_quantize_append_paged_kv_cache_with_slot_mapping
+        from flashinfer.sparse import qsa_sparse_paged_attention
+
+        self.num_kv_heads = num_kv_heads
+        self._append = nvfp4_quantize_append_paged_kv_cache_with_slot_mapping
+        self._attention = qsa_sparse_paged_attention
+
+    def write(
+        self,
+        cache: torch.Tensor,
+        key: torch.Tensor,
+        value: torch.Tensor,
+        slots: torch.Tensor,
+        k_scale: torch.Tensor,
+        v_scale: torch.Tensor,
+    ) -> None:
+        data, scales, layout = nvfp4_kv_views(cache, self.num_kv_heads)
+        self._append(
+            key, value, slots, data, scales, k_scale, v_scale, kv_layout=layout
+        )
+
+    def read(
+        self,
+        cache: torch.Tensor,
+        q: torch.Tensor,
+        indices: torch.Tensor,
+        table: torch.Tensor,
+        reqs: torch.Tensor,
+        prefill: bool,
+        out: torch.Tensor,
+        k_scale: float,
+        v_scale: float,
+        gate: torch.Tensor,
+    ) -> None:
+        (k, v), (ks, vs), layout = nvfp4_kv_views(cache, self.num_kv_heads)
+        if layout == "HND":
+            k, v, ks, vs = (x.transpose(1, 2) for x in (k, v, ks, vs))
+        # Pinned Cake SM120 clips the number of 64-token tiles, but does not
+        # mask entries past the count within the final tile. Preserve the
+        # packed count and mark that tail unmapped without modifying the
+        # indexer's shared selection buffer (which MTP can reuse).
+        width = indices.shape[1] - 1
+        columns = torch.arange(width, dtype=indices.dtype, device=indices.device)
+        counts = indices[:, -1:]
+        logical = indices[:, :-1].masked_fill(columns >= counts, -1)
+        indices = torch.cat((logical, counts), dim=1)
+        self._attention(
+            q,
+            k,
+            v,
+            indices,
+            table,
+            reqs,
+            prefill,
+            out,
+            k_scale,
+            v_scale,
+            output_gate=gate.reshape_as(q).contiguous(),
+            k_sf=ks,
+            v_sf=vs,
+            backend="cake",
+        )
+
+
+def validate_qsa_nvfp4_binding(
+    cache: torch.Tensor, num_kv_heads: int, block_size: int
+) -> None:
+    if (
+        cache.ndim != 4
+        or cache.dtype != torch.uint8
+        or cache.shape[0] == 0
+        or cache.shape[1:] != (2 * num_kv_heads, block_size, 144)
+    ):
+        raise ValueError(
+            "QSA NVFP4 requires uint8 [blocks, 2*kv_heads, physical_block_size, 144]"
+        )
+    if cache.shape[0] > 1 and cache.stride(0) < cache[0].numel():
+        raise ValueError("QSA NVFP4 KV pages overlap")
+    data, scales, _ = nvfp4_kv_views(cache, num_kv_heads)
+    # Check the actual layer offset and interleaved block stride before writing
+    # vectorized rows; both the data and E4M3 scales occupy one byte per item.
+    for tensor in (*data, *scales):
+        if tensor.data_ptr() % 16 or any(s % 16 for s in tensor.stride()[:-1]):
+            raise ValueError("QSA NVFP4 data and scales must be 16-byte aligned")
+
+
+def qsa_nvfp4_scales(k: torch.Tensor, v: torch.Tensor) -> tuple[float, float]:
+    if any(s.dtype != torch.float32 or s.numel() != 1 for s in (k, v)):
+        raise ValueError("QSA NVFP4 requires scalar float32 global scales")
+    ks, vs = k.item(), v.item()
+    if not (math.isfinite(ks) and ks > 0 and math.isfinite(vs) and vs > 0):
+        raise ValueError("QSA NVFP4 global scales must be finite and positive")
+    return ks, vs
+
+
+def validate_qsa_nvfp4_page(
+    spec: AttentionSpec,
+    requested: int | None,
+    pmu: int | None,
+    *,
+    prefix_caching: bool = False,
+) -> None:
+    if requested is not None and requested != spec.block_size:
+        raise ValueError(
+            f"QSA NVFP4 requested {requested} tokens but hybrid alignment resolved "
+            f"{spec.block_size}. Explicitly select the resolved page for this trial."
+        )
+    if (prefix_caching or pmu is not None) and pmu != spec.block_size:
+        raise ValueError(
+            "QSA NVFP4 sub-page prefix matches are not validated; set "
+            f"--prefix-match-unit {spec.block_size} for local prefix caching"
+        )
