# 以 B300 现用镜像为底座应用源码改动，保留原依赖及原生扩展。
FROM sha256:1a8a702f2bfeded3c90259ae60fefbd9e4ca014241946e7d5f3396badce99e76

COPY vllm /tmp/kimi-k31-source/vllm
COPY csrc /tmp/kimi-k31-source/csrc
COPY cmake /tmp/kimi-k31-source/cmake
COPY rust /tmp/kimi-k31-source/rust
COPY requirements /tmp/kimi-k31-source/requirements
COPY tools /tmp/kimi-k31-source/tools
COPY CMakeLists.txt setup.py pyproject.toml MANIFEST.in rust-toolchain.toml /tmp/kimi-k31-source/
COPY docker/kimi-k31/source-manifest.json docker/kimi-k31/native-input-manifest.json /tmp/kimi-k31-source/
COPY docker/kimi-k31/apply-source.py docker/kimi-k31/check-native-inputs.py /tmp/kimi-k31-source/

RUN python3 /tmp/kimi-k31-source/check-native-inputs.py \
    && python3 /tmp/kimi-k31-source/apply-source.py \
    && rm -rf /tmp/kimi-k31-source
