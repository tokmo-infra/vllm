# syntax=docker/dockerfile:1.7
ARG CUDA=13.0.3
FROM nvidia/cuda:${CUDA}-devel-ubuntu24.04 AS build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates git curl xz-utils python3 python3-dev python3-venv file \
 && python3 -m venv /opt/mc-build && apt-get clean
ENV PATH=/opt/mc-build/bin:/usr/local/go/bin:$PATH \
    LIBRARY_PATH=/usr/local/cuda/lib64/stubs \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/cuda/lib64/stubs
WORKDIR /src/mooncake
COPY --from=mooncake_src / /src/mooncake/
RUN bash dependencies.sh -y
ARG BUILD_JOBS=8
RUN cmake -G Ninja -S . -B build \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_FLAGS_RELEASE='-O2 -DNDEBUG' \
      -DPython3_EXECUTABLE=/opt/mc-build/bin/python3.12 \
      -DWITH_TE=ON -DWITH_STORE=ON -DUSE_HTTP=ON -DUSE_CUDA=ON \
      -DWITH_EP=OFF -DWITH_STORE_RUST=OFF -DUSE_NOF=OFF \
      -DUSE_ETCD=OFF -DSTORE_USE_ETCD=OFF -DENABLE_DEBUG_SYMBOLS=OFF \
      -DBUILD_UNIT_TESTS=OFF -DBUILD_BENCHMARK=OFF -DBUILD_EXAMPLES=ON \
 && cmake --build build --parallel "$BUILD_JOBS" \
 && CU13_BUILD=1 PYTHON_VERSION=3.12 OUTPUT_DIR=dist bash scripts/build_wheel.sh \
 && mkdir -p /wheels && cp mooncake-wheel/dist/*.whl /wheels/

FROM scratch AS wheels
COPY --from=build /wheels/ /

FROM nvidia/cuda:${CUDA}-runtime-ubuntu24.04 AS service
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv libibverbs1 ibverbs-providers librdmacm1 libnuma1 \
      liburing2 libcurl4t64 libssl3t64 ca-certificates \
 && python3 -m venv /opt/mooncake && apt-get clean
ENV PATH=/opt/mooncake/bin:$PATH
RUN --mount=type=bind,from=mooncake_wheels,source=/,target=/wheels,ro \
    /opt/mooncake/bin/pip install /wheels/mooncake_transfer_engine_cuda13-0.3.13.post1-*.whl \
 && test -x /opt/mooncake/bin/mooncake_master && test -x /opt/mooncake/bin/mooncake_client
