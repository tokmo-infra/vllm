+std::optional<std::vector<std::shared_ptr<BufferAllocatorBase>>>
+SegmentManager::SnapshotFitAllocators() const {
+    std::shared_lock<std::shared_mutex> lock(segment_mutex_);
+    std::vector<std::shared_ptr<BufferAllocatorBase>> result;
+    for (const auto& [id, mounted] : mounted_segments_) {
+        (void)id;
+        if (mounted.status != SegmentStatus::OK) continue;
+        if (mounted.segment.protocol == "cxl" || !mounted.buf_allocator ||
+            !std::dynamic_pointer_cast<OffsetBufferAllocator>(mounted.buf_allocator))
+            return std::nullopt;
+        result.push_back(mounted.buf_allocator);
+    }
+    if (result.empty()) return std::nullopt;
+    return result;
+}
