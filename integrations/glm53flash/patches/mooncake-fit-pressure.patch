diff --git a/mooncake-store/tests/fit_pressure_test.cpp b/mooncake-store/tests/fit_pressure_test.cpp
new file mode 100644
index 0000000..836e885
--- /dev/null
+++ b/mooncake-store/tests/fit_pressure_test.cpp
@@ -0,0 +1,78 @@
+#include <gtest/gtest.h>
+#include <cstdlib>
+#include <limits>
+#include "fit_pressure.h"
+#include "segment.h"
+
+using namespace mooncake;
+using namespace mooncake::fit_pressure;
+using namespace mooncake::offset_allocator;
+namespace {
+constexpr uint64_t MiB = 1024 * 1024;
+
+TEST(FitPressure, NativeNormalizationAndFitCounts) {
+    auto base = std::make_shared<OffsetBufferAllocator>("s", 0x100000000, 256 * MiB, "test");
+    auto offset = base->getOffsetAllocator();
+    ASSERT_TRUE(offset);
+    for (auto [bytes, expected_bin] : {
+             std::pair<uint64_t, uint64_t>{49381376, 48 * MiB},
+             {51 * MiB, 52 * MiB}, {60318720, 60 * MiB}}) {
+        const auto normalized = offset->normalizedAllocationSize(bytes);
+        EXPECT_EQ(normalized, expected_bin);
+        auto report = offset->storageReportFull();
+        uint64_t expected = 0;
+        for (const auto& bin : report.freeRegions)
+            expected += bin.count * (bin.size / normalized);
+        auto sample = SampleAllocators({base}, bytes);
+        ASSERT_TRUE(sample);
+        EXPECT_EQ(sample->slots, expected);
+    }
+}
+
+TEST(FitPressure, PlentyFreeButNoFit) {
+    OffsetAllocStorageReportFull report{};
+    report.freeRegions[0] = {44 * MiB, 1300};
+    Sample sample;
+    AddReport(sample, report, 48 * MiB);
+    EXPECT_EQ(sample.slots, 0);
+    EXPECT_GT(sample.free_bytes_lower_bound, 50ULL * 1024 * MiB);
+    EXPECT_TRUE(ShouldEvict({48 * MiB, 64, 1000}, sample));
+}
+
+TEST(FitPressure, DedupEmptyUnsupportedAndOverflow) {
+    auto a = std::make_shared<OffsetBufferAllocator>("s", 0x100000000, 128 * MiB, "test");
+    auto single = SampleAllocators({a}, 48 * MiB);
+    auto duplicate = SampleAllocators({a, a}, 48 * MiB);
+    ASSERT_TRUE(single); ASSERT_TRUE(duplicate);
+    EXPECT_EQ(single->slots, duplicate->slots);
+    EXPECT_EQ(duplicate->allocators, 1);
+    EXPECT_FALSE(SampleAllocators({}, 48 * MiB));
+    SegmentManager empty(BufferAllocatorType::OFFSET);
+    EXPECT_FALSE(empty.SnapshotFitAllocators());
+    auto other = std::make_shared<DummyBufferAllocator>("dummy", "test");
+    EXPECT_FALSE(SampleAllocators({a, other}, 48 * MiB));
+    EXPECT_FALSE(SampleAllocators({a}, 0));
+    OffsetAllocStorageReportFull report{};
+    const auto max = std::numeric_limits<uint64_t>::max();
+    report.freeRegions[0] = {max, max};
+    Sample overflow;
+    AddReport(overflow, report, 1);
+    EXPECT_EQ(overflow.slots, max);
+    EXPECT_EQ(overflow.free_bytes_lower_bound, max);
+}
+
+TEST(FitPressure, DefaultOffAndInvalidParameters) {
+    unsetenv("MC_EVICTION_FIT_REQUEST_BYTES");
+    unsetenv("MC_EVICTION_FIT_MIN_SLOTS");
+    unsetenv("MC_EVICTION_FIT_CHECK_MS");
+    auto config = ReadConfig(); ASSERT_TRUE(config);
+    EXPECT_EQ(config->request_bytes, 0);
+    EXPECT_FALSE(ShouldEvict(*config, Sample{0, 100, 1}));
+    setenv("MC_EVICTION_FIT_REQUEST_BYTES", "60318720", 1);
+    setenv("MC_EVICTION_FIT_CHECK_MS", "10", 1);
+    EXPECT_FALSE(ReadConfig());
+    unsetenv("MC_EVICTION_FIT_CHECK_MS");
+    EXPECT_TRUE(ReadConfig());
+    unsetenv("MC_EVICTION_FIT_REQUEST_BYTES");
+}
+}  // namespace
