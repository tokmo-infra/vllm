+#pragma once
+
+#include <algorithm>
+#include <charconv>
+#include <cstdint>
+#include <cstdlib>
+#include <limits>
+#include <memory>
+#include <optional>
+#include <string_view>
+#include <unordered_set>
+#include <vector>
+
+#include "allocator.h"
+
+namespace mooncake::fit_pressure {
+struct Config {
+    uint64_t request_bytes = 0;
+    uint64_t min_slots = 64;
+    uint64_t check_ms = 1000;
+};
+
+inline bool ParseUint(const char* text, uint64_t& value) {
+    if (!text || !*text) return false;
+    const std::string_view s(text);
+    const auto result = std::from_chars(s.data(), s.data() + s.size(), value);
+    return result.ec == std::errc{} && result.ptr == s.data() + s.size();
+}
+
+// Invalid enabled configurations fail closed. Default 0 never samples.
+inline std::optional<Config> ReadConfig() {
+    Config c;
+    const char* request = std::getenv("MC_EVICTION_FIT_REQUEST_BYTES");
+    if (!request) return c;
+    if (!ParseUint(request, c.request_bytes)) return std::nullopt;
+    if (!c.request_bytes) return c;
+    if (c.request_bytes > std::numeric_limits<size_t>::max()) return std::nullopt;
+    const char* slots = std::getenv("MC_EVICTION_FIT_MIN_SLOTS");
+    const char* ms = std::getenv("MC_EVICTION_FIT_CHECK_MS");
+    if ((slots && !ParseUint(slots, c.min_slots)) ||
+        (ms && !ParseUint(ms, c.check_ms)) || !c.min_slots ||
+        c.check_ms < 1000 || c.check_ms > 86400000) return std::nullopt;
+    return c;
+}
+
+inline uint64_t SatAdd(uint64_t a, uint64_t b) {
+    const auto max = std::numeric_limits<uint64_t>::max();
+    return a > max - b ? max : a + b;
+}
+inline uint64_t SatMul(uint64_t a, uint64_t b) {
+    const auto max = std::numeric_limits<uint64_t>::max();
+    return b && a > max / b ? max : a * b;
+}
+struct Sample { uint64_t slots = 0; uint64_t free_bytes_lower_bound = 0; size_t allocators = 0; };
+inline void AddReport(Sample& sample,
+                      const offset_allocator::OffsetAllocStorageReportFull& report,
+                      uint64_t normalized) {
+    for (const auto& bin : report.freeRegions) {
+        sample.slots = SatAdd(sample.slots, SatMul(bin.count, bin.size / normalized));
+        sample.free_bytes_lower_bound = SatAdd(sample.free_bytes_lower_bound,
+                                               SatMul(bin.count, bin.size));
+    }
+}
+
+// manager lock must already be released. Partial or unknown data is unavailable,
+// not zero: this avoids triggering from an incomplete segment population.
+inline std::optional<Sample> SampleAllocators(
+    const std::vector<std::shared_ptr<BufferAllocatorBase>>& allocators,
+    uint64_t request_bytes) {
+    if (allocators.empty() || !request_bytes ||
+        request_bytes > std::numeric_limits<size_t>::max()) return std::nullopt;
+    Sample sample;
+    std::unordered_set<const offset_allocator::OffsetAllocator*> seen;
+    for (const auto& base : allocators) {
+        auto offset = std::dynamic_pointer_cast<OffsetBufferAllocator>(base);
+        if (!offset) return std::nullopt;
+        auto allocator = offset->getOffsetAllocator();
+        if (!allocator) return std::nullopt;
+        if (!seen.insert(allocator.get()).second) continue;
+        auto normalized = allocator->normalizedAllocationSize(static_cast<size_t>(request_bytes));
+        if (!normalized) return std::nullopt;
+        AddReport(sample, allocator->storageReportFull(), normalized);
+        ++sample.allocators;
+    }
+    return sample.allocators ? std::optional<Sample>(sample) : std::nullopt;
+}
+inline bool ShouldEvict(const Config& c, const std::optional<Sample>& sample) {
+    return c.request_bytes && sample && sample->free_bytes_lower_bound &&
+           sample->slots < c.min_slots;
+}
+}  // namespace mooncake::fit_pressure
