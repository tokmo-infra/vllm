--- /dev/null
+++ b/vllm/distributed/kv_transfer/kv_connector/v1/mooncake/fp8_wire.py
@@ -0,0 +1,35 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Lossless FP8 NoPE512 wire -> GLM packed-MLA import.
+
+The source contains static-scale E4M3 bytes. GLM's packed reader accepts four
+arbitrary FP32 dequantization scales per row. Preserve the 512 bytes and repeat
+the producer's actual scale; do not requantize or assume scale == 1.
+"""
+import math
+import torch
+
+
+def import_fp8_nope512_blocks(cache, block_ids, scale, scratch=None):
+    if cache.ndim == 4 and cache.shape[1] == 1:
+        cache = cache[:, 0]
+    if cache.dtype != torch.uint8 or cache.ndim != 3 or cache.shape[-1] != 528:
+        raise ValueError('FP8 wire bridge requires uint8 [block,row,528]')
+    if cache.stride(1) != 528 or cache.stride(2) != 1:
+        raise ValueError('FP8 wire bridge requires contiguous rows inside each page')
+    if not math.isfinite(scale) or scale <= 0:
+        raise ValueError('invalid producer FP8 dequantization scale')
+    rows = cache.shape[1]
+    if scratch is None:
+        scratch = torch.empty((rows, 512), dtype=torch.uint8, device=cache.device)
+    if scratch.shape != (rows, 512) or scratch.device != cache.device:
+        raise ValueError('wire scratch shape/device mismatch')
+    for block in sorted(set(block_ids)):
+        if not 0 <= block < cache.shape[0]:
+            raise ValueError('wire destination block out of range')
+        page = cache[block]
+        # RDMA wrote a contiguous rows*512-byte source payload at this address.
+        # Stage BEFORE expanding, otherwise later input rows would be clobbered.
+        scratch.copy_(page.view(-1)[:rows * 512].view(rows, 512))
+        page[:, :512].copy_(scratch)
+        page[:, 512:].view(torch.float32).fill_(scale)
+    return scratch
