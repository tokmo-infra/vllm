diff --git a/vllm/models/glm5next/nvidia/sm120_dsa_adapter.py b/vllm/models/glm5next/nvidia/sm120_dsa_adapter.py
new file mode 100644
--- /dev/null
+++ b/vllm/models/glm5next/nvidia/sm120_dsa_adapter.py
@@ -0,0 +1,66 @@
+"""Opt-in FlashInfer #7085 paged indexer; GLM k-pool expansion stays native."""
+from functools import cache
+import os
+import torch
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+_reported = False
+
+def enabled():
+    return os.getenv('VLLM_SM120_DSA_INDEXER', '0') == '1'
+
+@cache
+def prewarm(device_index: int, max_rows: int, max_context: int):
+    if not enabled():
+        return
+    from flashinfer.experimental.sm120_dsa_indexer import _api
+    dev = torch.device('cuda',device_index)
+    # JIT and persistent scratch are initialized before CUDA graph capture.
+    _api._module()
+    _api._decode_logits(dev,max_rows,max_context)
+    if max_context > _api._row_sel_keys():
+        _api._decode_long_ws(dev,max_rows)
+
+def eligible(q, q_scale, dcp_world_size, top_k, sparse_indices):
+    return (enabled() and dcp_world_size == 1 and q_scale is None
+        and q.dtype == torch.float8_e4m3fn
+        and q.shape[-2] in (32,64) and q.shape[-1] == 128
+        and 1 <= q.shape[1] <= 16 and 1 <= top_k <= 4096)
+
+def paged_topk(q, kv_cache, weights, context_lens, block_table, top_k, max_context):
+    global _reported
+    from flashinfer.experimental.sm120_dsa_indexer import dsa_indexer_topk_paged
+    result,_ = dsa_indexer_topk_paged(q,kv_cache,weights,context_lens,block_table,
+        top_k=top_k,max_context_len=min(max_context,block_table.shape[1]*kv_cache.shape[1]),
+        return_scores=False)
+    if not _reported:
+        logger.info('GLM SM120 DSA indexer: FlashInfer PR7085 paged decode selected; kpool expansion unchanged')
+        _reported = True
+    return result
+
+
+_prefill_reported = False
+
+
+def prefill_eligible(q, k, q_scale, dcp_world_size, row_shard, chunk):
+    return (enabled() and dcp_world_size == 1 and row_shard is None
+            and q_scale is None and q.dtype == torch.float8_e4m3fn
+            and k.dtype == torch.float8_e4m3fn
+            and q.shape[-2] in (32, 64) and q.shape[-1] == 128
+            and chunk.sm120_query_start_loc is not None)
+
+
+def prefill_topk(q, k, k_scale, weights, chunk, top_k, ratio):
+    global _prefill_reported
+    from flashinfer.experimental.sm120_dsa_indexer import dsa_indexer_topk
+    result, _ = dsa_indexer_topk(
+        q, k, weights, chunk.sm120_query_start_loc, chunk.cu_seq_lens,
+        k_scale=k_scale, top_k=top_k,
+        q_causal_offsets=chunk.sm120_query_causal_offsets, ratio=ratio,
+        max_seqlen_k=chunk.sm120_max_seq_len, return_scores=False,
+    )
+    if not _prefill_reported:
+        logger.info('GLM SM120 DSA indexer: FlashInfer PR7085 ragged prefill selected; native causal ranges and kpool expansion unchanged')
+        _prefill_reported = True
+    return result
diff --git a/vllm/models/glm5next/nvidia/sm120_dsa_prefill.py b/vllm/models/glm5next/nvidia/sm120_dsa_prefill.py
new file mode 100644
--- /dev/null
+++ b/vllm/models/glm5next/nvidia/sm120_dsa_prefill.py
@@ -0,0 +1,121 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Exact-range SM120 prefill adapter for GLM5Next compressed index K cache.
+
+The generic ragged DSA API expresses visibility as a segment plus a causal
+ratio/offset. GLM metadata instead provides an exact [ks, ke) for every query
+row (not necessarily a 1:1 query/key mapping). This eager-only adapter packs
+each row's exact key interval as its own one-query segment, then maps returned
+segment-local IDs back to original packed-K coordinates.
+
+Bounded first-stage path: FP8 CUDA eager prefill and at most max_packed_keys
+duplicated keys. Catch UnsupportedPrefillShape to use DeepGEMM instead. JIT,
+build, and runtime errors are deliberately not caught or silently downgraded.
+"""
+
+from __future__ import annotations
+
+from typing import Sequence
+
+import torch
+
+
+class UnsupportedPrefillShape(RuntimeError):
+    """The exact-range prefill case is outside this helper's limited path."""
+
+
+def dsa_indexer_topk_prefill_ranges(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    k_scale: torch.Tensor,
+    weights: torch.Tensor,
+    cu_seqlen_ks: torch.Tensor,
+    cu_seqlen_ke: torch.Tensor,
+    *,
+    top_k: int,
+    max_packed_keys: int = 262_144,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Run SM120 top-k for exact per-query key ranges.
+
+    q is FP8 [num_rows, H, 128]; k is gathered FP8 [num_keys, 128]. k_scale
+    is FP32 [num_keys] or raw uint8 [num_keys, 4]. weights is [num_rows, H].
+    cu_seqlen_ks/ke are exact local key bounds for each query; device tensors
+    are read to host to construct variable-length segments. Returned indices
+    are restored to the original local packed-K coordinate, with -1 padding.
+
+    Not CUDA-graph capturable: variable-size segment packing is prefill-only.
+    """
+    if q.device.type != "cuda":
+        raise UnsupportedPrefillShape("SM120 prefill helper requires CUDA")
+    if torch.cuda.is_current_stream_capturing():
+        raise UnsupportedPrefillShape("exact-range prefill adapter is eager-only")
+    if q.dtype != torch.float8_e4m3fn or k.dtype != torch.float8_e4m3fn:
+        raise UnsupportedPrefillShape("exact-range prefill currently supports FP8 only")
+    if q.ndim != 3 or q.shape[-1] != 128 or q.shape[1] not in (32, 64):
+        raise UnsupportedPrefillShape("expected q=[rows, H32|H64, 128]")
+    if k.ndim != 2 or k.shape[-1] != 128:
+        raise UnsupportedPrefillShape("expected gathered k=[keys, 128]")
+    nrows = q.shape[0]
+    if weights.shape != q.shape[:2]:
+        raise ValueError(f"weights must have shape {tuple(q.shape[:2])}")
+    if cu_seqlen_ks.numel() != nrows or cu_seqlen_ke.numel() != nrows:
+        raise ValueError("row ks/ke tensors must contain one bound per query")
+    if out is not None and (out.shape != (nrows, top_k) or out.dtype != torch.int32):
+        raise ValueError("out must be int32 [num_rows, top_k]")
+
+    # Eager prefill sync is intentional: exact row ranges take precedence over
+    # inferring a potentially wrong causal offset for compressed GLM rows.
+    starts: Sequence[int] = cu_seqlen_ks.detach().to(device="cpu", dtype=torch.int64).tolist()
+    ends: Sequence[int] = cu_seqlen_ke.detach().to(device="cpu", dtype=torch.int64).tolist()
+    spans = [end - start for start, end in zip(starts, ends, strict=True)]
+    if any(start < 0 or end < start or end > k.shape[0] for start, end in zip(starts, ends, strict=True)):
+        raise ValueError("row key range is outside the gathered packed-K buffer")
+    total = sum(spans)
+    if total > max_packed_keys:
+        raise UnsupportedPrefillShape(
+            f"exact-range packing needs {total} keys, limit is {max_packed_keys}"
+        )
+
+    dev = q.device
+    # One query per segment, ratio=1 and no causal offset: every row sees the
+    # complete exact [ks, ke) interval, regardless of q/k compression ratio.
+    q_cu = torch.arange(nrows + 1, device=dev, dtype=torch.int32)
+    k_prefix = [0]
+    key_ids: list[int] = []
+    for start, end in zip(starts, ends, strict=True):
+        key_ids.extend(range(start, end))
+        k_prefix.append(k_prefix[-1] + end - start)
+    k_cu = torch.tensor(k_prefix, device=dev, dtype=torch.int32)
+
+    if k_scale.dtype == torch.uint8:
+        scales = k_scale.contiguous().view(torch.float32).reshape(-1)
+    elif k_scale.dtype == torch.float32:
+        scales = k_scale.contiguous().reshape(-1)
+    else:
+        raise UnsupportedPrefillShape("k_scale must be float32 or raw uint8 FP32 bytes")
+    if scales.numel() != k.shape[0]:
+        raise ValueError("k_scale must contain one FP32 scale per gathered key")
+    if key_ids:
+        gather_ids = torch.tensor(key_ids, device=dev, dtype=torch.int64)
+        packed_k = k.index_select(0, gather_ids).contiguous()
+        packed_scale = scales.index_select(0, gather_ids).contiguous()
+    else:
+        packed_k = k[:0].contiguous()
+        packed_scale = scales[:0].contiguous()
+
+    from flashinfer.experimental.sm120_dsa_indexer import dsa_indexer_topk
+
+    ids, _ = dsa_indexer_topk(
+        q.contiguous(), packed_k, weights.contiguous(), q_cu, k_cu,
+        k_scale=packed_scale, top_k=top_k, ratio=1,
+        max_seqlen_k=max(spans, default=0), indices=out, return_scores=False,
+    )
+
+    # Kernel IDs address the concatenated buffer; restore local source IDs for
+    # the existing DCP merge and kpool-to-token expansion downstream.
+    packed_base = k_cu[:-1].to(torch.int64)[:, None]
+    original_base = torch.tensor(starts, device=dev, dtype=torch.int64)[:, None]
+    valid = ids >= 0
+    mapped = ids.to(torch.int64) - packed_base + original_base
+    ids.copy_(torch.where(valid, mapped, -1).to(torch.int32))
+    return ids
