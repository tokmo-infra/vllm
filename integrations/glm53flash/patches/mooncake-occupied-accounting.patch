+TEST_F(BufferAllocatorTest, OffsetOccupiedSizeDoesNotCountMetadataExhaustion) {
+    auto allocator = offset_allocator::OffsetAllocator::create(
+        0x100000000ULL, 16 * 1024 * 1024, 8, 8);
+    std::vector<offset_allocator::OffsetAllocationHandle> handles;
+    size_t expected = 0;
+    for (size_t i = 0; i < 16; ++i) {
+        auto handle = allocator->allocate(5003);
+        if (!handle) break;
+        expected += allocator->normalizedAllocationSize(5003);
+        handles.push_back(std::move(*handle));
+    }
+    ASSERT_GT(handles.size(), 0u);
+    ASSERT_LT(handles.size(), 16u);
+    EXPECT_EQ(allocator->storageReport().totalFreeSpace, 0u);
+    EXPECT_EQ(allocator->occupiedSize(), expected);
+    handles.clear();
+    EXPECT_EQ(allocator->occupiedSize(), 0u);
+}
