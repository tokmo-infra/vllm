+        allocator = access.GetAllocator(segment.id);
+    }
+    auto buffer = allocator->allocate(5003);
+    ASSERT_NE(buffer, nullptr);
+    EXPECT_EQ(buffer->size(), 5003u);
+    EXPECT_GT(manager.GetMemoryUsage().used_bytes, 5003u);
+    EXPECT_EQ(manager.GetMemoryUsage().used_bytes, allocator->occupied_size());
+    const auto snapshot = manager.GetMemoryUsageSnapshot();
+    EXPECT_EQ(snapshot.used_bytes, 5003u);
+    EXPECT_EQ(snapshot.segments.at(segment.name).used_bytes, 5003u);
+    buffer.reset();
+    EXPECT_EQ(manager.GetMemoryUsage().used_bytes, 0u);
+}
