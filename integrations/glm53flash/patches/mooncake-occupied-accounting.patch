+TEST_F(BufferAllocatorTest, OffsetWatermarkCountsOccupiedBinSpace) {
+    constexpr size_t kCapacity = 1024ULL * 1024 * 1024;
+    auto allocator = std::make_shared<OffsetBufferAllocator>(
+        "occupied-kv", 0x100000000ULL, kCapacity, "occupied-kv");
+    auto tracker = std::make_shared<StorageUsageTracker>();
+    allocator->AttachUsageTracker(tracker);
+    const std::vector<size_t> sizes = {
+        53870592, 49381376, 49381376, 60318720, 123, 5003, 777};
+    std::vector<std::unique_ptr<AllocatedBuffer>> buffers;
+    size_t payload = 0;
+    for (size_t bytes : sizes) {
+        auto buffer = allocator->allocate(bytes);
+        ASSERT_NE(buffer, nullptr);
+        EXPECT_EQ(buffer->get_descriptor().size_, bytes);
+        payload += bytes;
+        buffers.push_back(std::move(buffer));
+        EXPECT_EQ(allocator->size(), payload);
+        EXPECT_EQ(tracker->GetUsage().used_bytes,
+                  allocator->getOffsetAllocator()->occupiedSize());
+        EXPECT_EQ(allocator->occupied_size(), tracker->GetUsage().used_bytes);
+    }
+    EXPECT_GT(tracker->GetUsage().used_bytes, payload);
+    const size_t before_failure = tracker->GetUsage().used_bytes;
+    EXPECT_EQ(allocator->allocate(kCapacity), nullptr);
+    EXPECT_EQ(tracker->GetUsage().used_bytes, before_failure);
+    buffers.erase(buffers.begin() + 1);
+    EXPECT_EQ(tracker->GetUsage().used_bytes,
+              allocator->getOffsetAllocator()->occupiedSize());
+    buffers.clear();
+    EXPECT_EQ(tracker->GetUsage().used_bytes, 0u);
+    EXPECT_EQ(allocator->size(), 0u);
+}
+
+TEST_F(BufferAllocatorTest, OffsetOccupiedUsageSupportsLateAttachAndTeardown) {
+    auto tracker = std::make_shared<StorageUsageTracker>();
+    auto allocator = std::make_shared<OffsetBufferAllocator>(
+        "occupied-lifetime", 0x100000000ULL, 16 * 1024 * 1024,
+        "occupied-lifetime");
+    auto buffer = allocator->allocate(5003);
+    ASSERT_NE(buffer, nullptr);
+    allocator->AttachUsageTracker(tracker);
+    allocator->AttachUsageTracker(tracker);
+    EXPECT_EQ(tracker->GetUsage().used_bytes,
+              allocator->getOffsetAllocator()->occupiedSize());
+    EXPECT_EQ(tracker->GetUsage().capacity_bytes, allocator->capacity());
+    allocator.reset();
+    EXPECT_EQ(tracker->GetUsage().used_bytes, 0u);
+    EXPECT_EQ(tracker->GetUsage().capacity_bytes, 0u);
+    buffer.reset();
+    EXPECT_EQ(tracker->GetUsage().used_bytes, 0u);
+}
+
+TEST_F(BufferAllocatorTest, OffsetOccupiedUsageIsSymmetricUnderConcurrency) {
+    auto tracker = std::make_shared<StorageUsageTracker>();
+    auto allocator = std::make_shared<OffsetBufferAllocator>(
+        "occupied-concurrent", 0x100000000ULL, 16 * 1024 * 1024,
+        "occupied-concurrent");
+    allocator->AttachUsageTracker(tracker);
+    std::atomic<size_t> failures{0};
+    std::vector<std::thread> threads;
+    for (size_t rank = 0; rank < 4; ++rank) {
+        threads.emplace_back([&, rank] {
+            for (size_t i = 0; i < 1000; ++i) {
+                auto a = allocator->allocate(5003 + rank + i % 123);
+                auto b = allocator->allocate(777 + rank);
+                if (!a || !b) ++failures;
+            }
+        });
+    }
+    for (auto& thread : threads) thread.join();
+    EXPECT_EQ(failures.load(), 0u);
+    EXPECT_EQ(allocator->size(), 0u);
+    EXPECT_EQ(allocator->occupied_size(), 0u);
+    EXPECT_EQ(tracker->GetUsage().used_bytes, 0u);
+    EXPECT_EQ(allocator->getOffsetAllocator()->occupiedSize(), 0u);
+}
+
+TEST_F(BufferAllocatorTest, OffsetDescriptorRestorePreservesBothUsageMeasures) {
+    constexpr size_t kBase = 0x100000000ULL;
+    constexpr size_t kCapacity = 16 * 1024 * 1024;
+    const std::string segment = "occupied-restore";
+    auto original = std::make_shared<OffsetBufferAllocator>(
+        segment, kBase, kCapacity, segment);
+    auto a = original->allocate(5003);
+    auto hole = original->allocate(777);
+    auto b = original->allocate(123);
+    ASSERT_TRUE(a && hole && b);
+    std::vector<AllocatedBuffer::Descriptor> descriptors = {
+        a->get_descriptor(), b->get_descriptor()};
+    hole.reset();
+    auto restored = RestoreOffsetBufferAllocator(
+        segment, kBase, kCapacity, segment, descriptors);
+    ASSERT_TRUE(restored.has_value());
+    auto tracker = std::make_shared<StorageUsageTracker>();
+    restored->allocator->AttachUsageTracker(tracker);
+    EXPECT_EQ(restored->allocator->size(), 5126u);
+    EXPECT_EQ(tracker->GetUsage().used_bytes, original->occupied_size());
+    restored->buffers.clear();
+    EXPECT_EQ(tracker->GetUsage().used_bytes, 0u);
+    EXPECT_EQ(restored->allocator->occupied_size(), 0u);
+}
