+    MsgpackPacker packer(&buffer);
+    ASSERT_TRUE(Serializer<OffsetBufferAllocator>::serialize(*original, packer)
+                    .has_value());
+    auto object = msgpack::unpack(buffer.data(), buffer.size());
+    ASSERT_EQ(object.get().via.array.size, 6u);
+    auto result = Serializer<OffsetBufferAllocator>::deserialize(object.get());
+    ASSERT_TRUE(result.has_value());
+    auto restored = result.value();
+    EXPECT_EQ(restored->size(), original->size());
+    EXPECT_EQ(restored->occupied_size(), original->occupied_size());
+    auto tracker = std::make_shared<StorageUsageTracker>();
+    restored->AttachUsageTracker(tracker);
+    EXPECT_EQ(tracker->GetUsage().used_bytes, original->occupied_size());
+    const size_t occupied = tracker->GetUsage().used_bytes;
+    {
+        auto extra = restored->allocate(123);
+        ASSERT_NE(extra, nullptr);
+        EXPECT_EQ(restored->occupied_size(),
+                  restored->getOffsetAllocator()->occupiedSize());
+    }
+    EXPECT_EQ(tracker->GetUsage().used_bytes, occupied);
+    restored.reset();
+    result.value().reset();
+    EXPECT_EQ(tracker->GetUsage().used_bytes, 0u);
+    EXPECT_EQ(tracker->GetUsage().capacity_bytes, 0u);
