+TEST_F(SerializerTest, OffsetSnapshotRestoresOccupiedUsageWithoutFormatChange) {
+    auto original = std::make_shared<OffsetBufferAllocator>(
+        "occupied-snapshot", 0x300000000ULL, 16 * 1024 * 1024,
+        "occupied-snapshot");
