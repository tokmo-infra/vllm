+          v_1 = __fadd_rn(v_1, __shfl_xor_sync(0xffffffffu, v_1, 1));
+          v_0 = __fadd_rn(v_0, __shfl_xor_sync(0xffffffffu, v_0, 2));
+          v_1 = __fadd_rn(v_1, __shfl_xor_sync(0xffffffffu, v_1, 2));
