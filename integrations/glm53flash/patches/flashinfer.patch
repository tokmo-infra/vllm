+        float rtau[kBlockQ];
+#pragma unroll
+        for (int qi = 0; qi < kBlockQ; ++qi) {
+          const int r = row0 + qi;
+          const bool ok = r < num_rows_ && (only_qi < 0 || qi == only_qi);
