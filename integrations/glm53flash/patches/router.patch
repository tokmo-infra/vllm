+        let frame = body.frame().await.unwrap().unwrap();
+        assert_eq!(frame.into_trailers().unwrap()["x-test-trailer"], "preserved");
+        assert_eq!(worker.load(), 2);
+        assert!(body.frame().await.is_none());
+        assert_eq!(worker.load(), 1);
+        drop(body);
+        assert_eq!(worker.load(), 1);
+        drop(sentinel);
