+    fn test_reserved_admission_barrier_hot_cold_and_sentinel() {
+        use crate::policies::{CacheAwareConfig, CacheAwarePolicy};
+        use std::sync::Barrier;
+        for n in [16, 32] {
+            let policy = CacheAwarePolicy::with_config(CacheAwareConfig {
