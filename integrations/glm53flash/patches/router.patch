+fn select_and_reserve_decode(
+    admission: &parking_lot::Mutex<()>,
+    policy: &dyn LoadBalancingPolicy,
+    workers: &[Arc<dyn Worker>],
+    text: Option<&str>,
+    headers: Option<&RequestHeaders>,
+) -> Option<(usize, OwnedLoadReservation)> {
+    let _lock = admission.lock();
