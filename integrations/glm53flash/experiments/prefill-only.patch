+
+    def _release_finished_pd_mamba_scratch(self, request: Request) -> int:
+        """Keep the committed/checkpoint states; retire only trailing draft slots.
+
+        The PD connector has already snapshotted the original block table and
+        explicitly transfers only its committed state. Store jobs separately
+        own references. The native processed-step fence orders reuse after any
+        outstanding GPU writes; it is not a DMA-completion shortcut.
+        """
+        params = request.kv_transfer_params or {}
+        cfg = self.vllm_config.kv_transfer_config
+        if (
+            not params.get("do_remote_decode")
+            or request.max_tokens != 1
+            or request.status != RequestStatus.FINISHED_LENGTH_CAPPED
+            or cfg is None
+        ):
+            return 0
+        enabled = any(
+            child.get("kv_connector") == "MooncakeConnector"
+            and child.get("kv_role") == "kv_producer"
+            and child.get("kv_connector_extra_config", {}).get("mamba_current_state_only") is True
+            and child.get("kv_connector_extra_config", {}).get("release_finished_mamba_scratch") is True
+            for child in cfg.kv_connector_extra_config.get("connectors", ())
+        )
+        if not enabled:
+            return 0
+        released = []
+        for manager in self.kv_cache_manager.coordinator.single_type_managers:
+            spec = manager.kv_cache_spec
+            if not isinstance(spec, MambaSpec) or spec.mamba_cache_mode != "align":
+                continue
+            n = manager.num_speculative_blocks
+            blocks = manager.req_to_blocks.get(request.request_id, [])
+            if n <= 0 or len(blocks) <= n:
+                continue
+            scratch = blocks[-n:]
+            del blocks[-n:]
+            released.extend(block for block in scratch if not block.is_null)
+        if released:
+            # Same fence and refcount path used by native retained CoW copies.
+            # Other owners (including in-flight Store puts) retain their refs.
+            self._free_cow_retained_blocks(released[::-1], request.last_sched_seq)
+            request._glm_pd_scratch_released = True
+            self._glm_pd_scratch_released = getattr(self, "_glm_pd_scratch_released", 0) + len(released)
+        return len(released)
 
     def _free_blocks(self, request: Request):
         assert request.is_finished()
