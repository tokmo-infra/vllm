+def _mamba_committed_transfer_blocks(block_ids: list[int], num_speculative_blocks: int) -> list[int]:
+    """Select the current state before trailing draft scratch slots.
+
+    Align-mode block tables end in [committed, draft0, ...]. Interior
+    null placeholders and older checkpoints must not shift this suffix.
+    An empty list means this group needs no remote load.
+    """
+    if not block_ids:
+        return []
+    if num_speculative_blocks < 0 or len(block_ids) <= num_speculative_blocks:
+        raise ValueError("Mamba transfer table lacks a committed state before draft scratch")
+    block_id = block_ids[-1 - num_speculative_blocks]
+    if block_id == NULL_BLOCK_ID:
+        raise ValueError("Mamba committed transfer state is a null placeholder")
+    return [block_id]
+
