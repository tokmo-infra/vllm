# Pass the immutable shared-tokenizer image ID for the target host.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY integrations/glm53flash/patches/vllm-get-batch-runtime.patch /tmp/vllm-get-batch-runtime.patch
RUN python3 -c "import hashlib,pathlib; p=pathlib.Path('/usr/local/lib/python3.12/dist-packages/vllm/distributed/kv_transfer/kv_connector/v1/mooncake/store/worker.py'); h=hashlib.sha256(p.read_bytes()).hexdigest(); expected='90a457d10975d132c5883a00ecbfdac855064725eecfa894c36c8d4ffa4bc5b5'; assert h==expected, f'Unexpected runtime worker {h}; expected {expected}'" && \
    cd /usr/local/lib/python3.12/dist-packages && \
    patch -p1 --dry-run < /tmp/vllm-get-batch-runtime.patch && \
    patch -p1 < /tmp/vllm-get-batch-runtime.patch && \
    python3 -c "import ast,pathlib; ast.parse(pathlib.Path('vllm/distributed/kv_transfer/kv_connector/v1/mooncake/store/worker.py').read_text())" && \
    rm /tmp/vllm-get-batch-runtime.patch
LABEL glm.cache.get_batch="opt-in; default off"
