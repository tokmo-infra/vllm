# deploy.env
P_IP='11.1.0.85'
D1_IP='11.1.0.86'
P_NET_IF='ens86np0'
D1_NET_IF='ens86np0'

# 各实例 HTTP、KV bootstrap、DP RPC；按现场调整
P0_HTTP_PORT=28483; P0_BOOTSTRAP_PORT=29083; P0_DP_RPC_PORT=29550
P1_HTTP_PORT=28493; P1_BOOTSTRAP_PORT=29093; P1_DP_RPC_PORT=29650
D1_HTTP_PORT=28483; D1_BOOTSTRAP_PORT=29083; D1_DP_RPC_PORT=29550
ROUTER_PORT=28300; ROUTER_METRICS_PORT=28301
ROUTER_REQUEST_TIMEOUT_SECS=3600
MASTER_RPC_PORT=61741; MASTER_METADATA_PORT=61742; MASTER_METRICS_PORT=61743
STORE_RPC_PORT=61744; STORE_HEALTH_PORT=61745

# 下列监听地址与 RDMA 设备映射按现场填写
ROUTER_BIND_HOST=0.0.0.0
ROUTER_METRICS_BIND_HOST=0.0.0.0
MASTER_METADATA_BIND_HOST=0.0.0.0
P_GID_INDEX=3; D1_GID_INDEX=3
P0_HCAS='mlx5_2,mlx5_3'
P1_HCAS='mlx5_4,mlx5_5'
D1_HCAS='mlx5_2,mlx5_3,mlx5_4,mlx5_5'

# 仅记录密钥文件路径。两台文件内容一致，归 root 所有，权限 0600。
INTERNAL_API_KEY_FILE='/data/services/glm53flash-1p1d-8586/engine.key'
SERVICE_PREFIX=glm53flash-1p1d-8586
MODEL_DIR='/data/models/GLM-5.3-Flash-NVFP4'
SERVICE_ROOT='/data/services'
COMPILE_CACHE_ROOT='/var/cache/glm53-c32-1126'
L3_MOUNT='/data'
L2_P_GIB=700; L2_D1_GIB=650
DRAFT_DIR=/data/models/GLM-5.3-Flash-DFlash2
